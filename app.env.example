# Copy to a private environment file and replace every placeholder before starting.
# Do not commit the live app.env file or put real secrets in this template.
# Unlisted settings use application defaults.
OCP_TOKEN_SIGNING_KEY=replace-with-a-random-secret-at-least-32-characters
OCP_DATABASE_PATH=./ocp.db
OCP_ISSUER_URL=https://connector.example.com

# Optional: set these only when using a configured source database profile.
# The profile name must match the name passed to `ocp configure-source`.
# OCP_SOURCE_DB_PROFILE=your-source-profile
# OCP_SOURCE_DB_PASSWORD=replace-with-the-read-only-source-database-password

# Optional: set both values to enable the Observium integration.
# TLS verification remains enabled by default.
# OCP_OBSERVIUM_BASE_URL=https://observium.example.com
# OCP_OBSERVIUM_API_TOKEN=replace-with-a-read-only-Observium-token
# OCP_OBSERVIUM_CA_BUNDLE=/path/to/observium-ca.pem
