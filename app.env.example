# Copy to a private environment file and replace every placeholder before starting.
# Do not commit the live app.env file or put real secrets in this template.
# Unlisted settings use application defaults.
OCP_TOKEN_SIGNING_KEY=replace-with-a-random-secret-at-least-32-characters
OCP_DATABASE_PATH=./ocp.db
OCP_ISSUER_URL=https://connector.example.com
# Optional UI origin when different from the issuer (for example an SSH tunnel).
# OCP_ADMIN_BASE_URL=http://127.0.0.1:8000
# Testing only: allows unencrypted HTTP on literal RFC1918/ULA private IPs.
# Passwords, sessions and partner credentials will not be encrypted.
# OCP_ALLOW_INSECURE_HTTP=true
# Optional private portal pairing file; the connector also runs its heartbeats.
# OCP_PORTAL_CONNECTION_FILE=/home/connector/.open-carrier-portal/portal-connection.json

# Required: configure this profile with `ocp configure-source` before starting.
OCP_SOURCE_DB_PROFILE=your-source-profile
OCP_SOURCE_DB_PASSWORD=replace-with-the-read-only-source-database-password

# Required Observium endpoint and read-only API token.
OCP_OBSERVIUM_BASE_URL=https://observium.example.com
OCP_OBSERVIUM_API_TOKEN=replace-with-a-read-only-Observium-token
# Optional when Observium uses a private CA; TLS verification remains enabled.
# OCP_OBSERVIUM_CA_BUNDLE=/path/to/observium-ca.pem
